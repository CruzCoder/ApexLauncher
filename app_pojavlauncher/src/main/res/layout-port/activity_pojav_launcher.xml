<?xml version="1.0" encoding="utf-8"?>
<!--
    Apex Launcher - home screen (portrait).
    Same view ids as the landscape layout so LauncherActivity stays layout-agnostic.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apex_bg">

    <ImageView
        android:id="@+id/apex_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/apex_background" />

    <View
        android:id="@+id/apex_backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/apex_scrim" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/apex_home_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===================== header ===================== -->
        <LinearLayout
            android:id="@+id/apex_header"
            android:layout_width="0dp"
            android:layout_height="@dimen/_56sdp"
            android:layout_marginStart="@dimen/apex_gutter"
        android:layout_marginEnd="@dimen/apex_gutter"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/apex_logo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:contentDescription="@string/apex_brand"
                android:src="@drawable/ic_apex_logo" />

            <TextView
                android:id="@+id/apex_wordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_moderate"
                android:layout_weight="1"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.18"
                android:text="@string/apex_wordmark"
                android:textAllCaps="true"
                android:textColor="@color/apex_text"
                android:textSize="@dimen/apex_text_subtitle" />

            <com.kdt.mcgui.mcAccountSpinner
                android:id="@+id/account_spinner"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="@drawable/apex_chip"
                android:dropDownWidth="@dimen/_180sdp"
                android:dropDownVerticalOffset="@dimen/_40sdp" />
        </LinearLayout>

        <!-- ===================== hero ===================== -->
        <FrameLayout
            android:id="@+id/apex_hero"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/apex_gutter"
        android:layout_marginEnd="@dimen/apex_gutter"
            android:layout_marginTop="@dimen/padding_small"
            android:background="@drawable/apex_glass_card_strong"
            android:clipToOutline="true"
            app:layout_constraintBottom_toTopOf="@+id/apex_info_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="@dimen/_240sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/apex_header">

            <ImageView
                android:id="@+id/apex_hero_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/apex_hero_art" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/apex_hero_scrim" />

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/apex_card_padding"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/apex_hero_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/apex_chip_active"
                    android:fontFamily="@font/minecraft_ten"
                    android:paddingStart="@dimen/_9sdp"
        android:paddingEnd="@dimen/_9sdp"
                    android:paddingTop="@dimen/_3sdp"
        android:paddingBottom="@dimen/_3sdp"
                    android:text="@string/apex_hero_tag_current"
                    android:textAllCaps="true"
                    android:textColor="@color/apex_accent_light"
                    android:textSize="@dimen/apex_text_caption" />

                <TextView
                    android:id="@+id/apex_instance_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_moderate"
                    android:ellipsize="end"
                    android:fontFamily="@font/noto_sans_bold"
                    android:maxLines="1"
                    android:textColor="@color/apex_text"
                    android:textSize="@dimen/apex_text_title"
                    tools:text="Fabric 1.21.4" />

                <TextView
                    android:id="@+id/apex_instance_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:alpha="0.9"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/apex_text_dim"
                    android:textSize="@dimen/apex_text_body"
                    tools:text="Zink renderer · 4 GB RAM · Java 21" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/apex_more_button"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/padding_heavy"
                android:background="@drawable/apex_icon_button_bg"
                android:contentDescription="@string/apex_more"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_more_horiz"
                android:tint="@color/apex_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="@dimen/apex_card_padding"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/change_version_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:background="@drawable/apex_btn_ghost"
                    android:drawableStart="@drawable/ic_nav_library"
                    android:drawablePadding="@dimen/padding_moderate"
                    android:fontFamily="@font/noto_sans_bold"
                    android:paddingStart="@dimen/padding_moderate"
        android:paddingEnd="@dimen/padding_moderate"
                    android:text="@string/apex_change_version"
                    android:textAllCaps="false"
                    android:textColor="@color/apex_text"
                    android:textSize="@dimen/apex_text_body" />

                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="@dimen/padding_moderate"
                    android:background="@drawable/apex_btn_ghost"
                    android:contentDescription="@string/apex_edit_profile"
                    android:padding="@dimen/_10sdp"
                    android:src="@drawable/ic_edit_profile"
                    android:tint="@color/apex_text" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===================== info row ===================== -->
        <LinearLayout
            android:id="@+id/apex_info_row"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/apex_gutter"
        android:layout_marginEnd="@dimen/apex_gutter"
            android:layout_marginTop="@dimen/padding_heavy"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/play_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.28"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/apex_hero">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/apex_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/apex_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/apex_session"
                    android:textAllCaps="true"
                    android:textColor="@color/apex_text_dim"
                    android:textSize="@dimen/apex_text_caption" />

                <TextView
                    android:id="@+id/apex_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:textColor="@color/apex_text"
                    android:textSize="@dimen/apex_text_title"
                    tools:text="14:32" />

                <TextView
                    android:id="@+id/apex_memory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/apex_text_dim"
                    android:textSize="@dimen/apex_text_caption"
                    tools:text="Free RAM 3.2 GB of 8.0 GB" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/padding_heavy"
                android:layout_weight="1.4"
                android:background="@drawable/apex_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/apex_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="@string/apex_recently_played"
                        android:textAllCaps="true"
                        android:textColor="@color/apex_text_dim"
                        android:textSize="@dimen/apex_text_caption" />

                    <TextView
                        android:id="@+id/apex_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/padding_small"
                        android:text="@string/apex_view_all"
                        android:textColor="@color/apex_accent"
                        android:textSize="@dimen/apex_text_caption" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/apex_recent_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== progress + bottom bar ===================== -->
        <com.kdt.mcgui.ProgressLayout
            android:id="@+id/progress_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/apex_gutter"
        android:layout_marginEnd="@dimen/apex_gutter"
            android:layout_marginBottom="@dimen/padding_moderate"
            app:layout_constraintBottom_toTopOf="@+id/play_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/apex_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/apex_bottom_bar_height"
            android:layout_marginStart="@dimen/apex_gutter"
        android:layout_marginEnd="@dimen/apex_gutter"
            android:layout_marginBottom="@dimen/apex_gutter"
            android:background="@drawable/apex_rail_bg"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_moderate"
        android:paddingEnd="@dimen/padding_moderate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.kdt.mcgui.ApexNavItem
                android:id="@+id/apex_nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:apexNavIcon="@drawable/ic_nav_home"
                app:apexNavLabel="@string/apex_nav_home" />

            <com.kdt.mcgui.ApexNavItem
                android:id="@+id/apex_nav_library"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:apexNavIcon="@drawable/ic_nav_library"
                app:apexNavLabel="@string/apex_nav_library" />

            <com.kdt.mcgui.ApexNavItem
                android:id="@+id/apex_nav_mods"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:apexNavIcon="@drawable/ic_nav_store"
                app:apexNavLabel="@string/apex_nav_mods" />

            <com.kdt.mcgui.ApexNavItem
                android:id="@+id/apex_nav_controls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:apexNavIcon="@drawable/ic_nav_controls"
                app:apexNavLabel="@string/apex_nav_controls" />

            <com.kdt.mcgui.ApexNavItem
                android:id="@+id/apex_nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:apexNavIcon="@drawable/ic_nav_settings"
                app:apexNavLabel="@string/apex_nav_settings" />
        </LinearLayout>

        <!-- the big play button lives above the bottom bar in portrait -->
        <Button
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/apex_play_height"
            android:layout_marginStart="@dimen/apex_gutter"
        android:layout_marginEnd="@dimen/apex_gutter"
            android:layout_marginBottom="@dimen/padding_moderate"
            android:background="@drawable/apex_btn_play"
            android:drawableStart="@drawable/ic_apex_play_dark"
            android:drawablePadding="@dimen/padding_moderate"
            android:fontFamily="@font/noto_sans_bold"
            android:letterSpacing="0.12"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textColor="@color/apex_bg"
            android:textSize="@dimen/apex_text_subtitle"
            app:layout_constraintBottom_toTopOf="@+id/apex_bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_fragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

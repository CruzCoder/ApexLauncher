<?xml version="1.0" encoding="utf-8"?>
<!-- Local (offline) account : glass panel over the dashboard wallpaper -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:id="@+id/login_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glass_strong"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/_520sdp"
        app:layout_constraintWidth_percent="0.86">

        <TextView
            style="@style/ApexSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_local_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="@string/auth_local_sub"
            android:textColor="@color/apex_text_secondary"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/login_online_username_hint"
            android:textColor="@color/apex_text_tertiary"
            android:textSize="@dimen/_10ssp" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/login_edit_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textVisiblePassword"
            android:singleLine="true"
            android:textColor="@color/apex_text_primary"
            android:textColorHint="@color/apex_text_tertiary"
            android:textSize="@dimen/_13ssp" />

        <Button
            android:id="@+id/login_button"
            style="@style/ApexPlayButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:drawableStart="@drawable/ic_apex_play_dark"
            android:drawablePadding="@dimen/_6sdp"
            android:text="@string/local_login_sign_in" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/auth_footnote"
            android:textColor="@color/apex_text_tertiary"
            android:textSize="@dimen/_9ssp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

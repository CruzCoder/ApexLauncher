<?xml version="1.0" encoding="utf-8"?>
<!-- Apex launcher dashboard, portrait : stacked cards, same ids as the landscape layout -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Left icon rail -->
    <LinearLayout
        android:id="@+id/rail_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/bg_rail_glass"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/rail_home"
            style="@style/ApexRailButtonActive"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:contentDescription="@string/dashboard_cd_home"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_apex_home" />

        <ImageButton
            android:id="@+id/news_button"
            style="@style/ApexRailButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:contentDescription="@string/dashboard_cd_news"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_menu_news" />

        <ImageButton
            android:id="@+id/explore_button"
            style="@style/ApexRailButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:contentDescription="@string/dashboard_cd_explore"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_apex_explore" />

        <ImageButton
            android:id="@+id/install_jar_button"
            style="@style/ApexRailButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:contentDescription="@string/dashboard_cd_install"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_apex_plus" />

        <ImageButton
            android:id="@+id/custom_control_button"
            style="@style/ApexRailButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:contentDescription="@string/dashboard_cd_controls"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_menu_custom_controls" />

        <ImageButton
            android:id="@+id/open_files_button"
            style="@style/ApexRailButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:contentDescription="@string/dashboard_cd_folder"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_folder" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/dashboard_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail_menu"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_10sdp">

            <TextView
                style="@style/ApexSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title" />

            <!-- Player strip -->
            <LinearLayout
                android:id="@+id/player_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_card_glass_strong"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/dashboard_avatar"
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_52sdp"
                    android:contentDescription="@string/dashboard_player"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dashboard_player_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:maxLines="1"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="@dimen/_14ssp"
                        tools:text="1.12.2" />

                    <TextView
                        android:id="@+id/dashboard_player_build"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/apex_mint"
                        android:textSize="@dimen/_9ssp"
                        tools:text="Minecraft 1.12.2" />
                </LinearLayout>

                <Button
                    android:id="@+id/play_button_side"
                    style="@style/ApexPlayButtonCompact"
                    android:layout_width="@dimen/_92sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:drawableStart="@drawable/ic_apex_play_dark"
                    android:drawablePadding="@dimen/_4sdp"
                    android:text="@string/dashboard_play" />
            </LinearLayout>

            <!-- Quick cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_socials"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_68sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:layout_width="@dimen/_34sdp"
                        android:layout_height="@dimen/_34sdp"
                        android:background="@drawable/bg_icon_tile_mint"
                        android:contentDescription="@string/dashboard_socials_title"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_apex_people"
                        android:tint="@color/apex_mint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ApexCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_socials_title"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            style="@style/ApexCardSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_socials_sub"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_explore"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_68sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10sdp">

                    <ImageView
                        android:layout_width="@dimen/_34sdp"
                        android:layout_height="@dimen/_34sdp"
                        android:background="@drawable/bg_icon_tile_accent"
                        android:contentDescription="@string/dashboard_explore_title"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_apex_explore"
                        android:tint="@color/apex_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ApexCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_explore_title"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            style="@style/ApexCardSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_explore_sub"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- You -->
            <LinearLayout
                android:id="@+id/card_you"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_card_glass"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:background="@drawable/bg_icon_tile_neutral"
                    android:contentDescription="@string/dashboard_you_title"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_apex_person"
                    android:tint="@color/apex_text_primary" />

                <TextView
                    style="@style/ApexCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:text="@string/dashboard_you_title" />

                <TextView
                    style="@style/ApexCardSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_you_sub" />
            </LinearLayout>

            <!-- Active world -->
            <LinearLayout
                android:id="@+id/card_active_world"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_card_glass_flat"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <TextView
                    style="@style/ApexSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_active_world" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_active_world_sub"
                    android:textColor="@color/apex_text_secondary"
                    android:textSize="@dimen/_9ssp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        style="@style/ApexInstanceTitle"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawablePadding="@dimen/_8sdp"
                        android:gravity="center_vertical"
                        android:paddingEnd="@dimen/_4sdp"
                        android:paddingStart="0dp"
                        android:textSize="@dimen/_18ssp"
                        android:drawableEnd="@drawable/spinner_arrow"
                        app:drawableEndPadding="@dimen/_1sdp"
                        app:drawableEndSize="@dimen/_9sdp"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="@dimen/_38sdp"
                        tools:ignore="RtlSymmetry" />

                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="@dimen/_36sdp"
                        android:layout_height="@dimen/_36sdp"
                        android:background="@drawable/bg_gear_button"
                        android:contentDescription="@string/dashboard_you_title"
                        android:padding="@dimen/_8sdp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_menu_settings"
                        android:tint="@color/apex_text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_build_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_46sdp"
                    android:textColor="@color/apex_text_secondary"
                    android:textSize="@dimen/_10ssp"
                    tools:text="Vanilla · Minecraft 1.12.2" />

                <Button
                    android:id="@+id/play_button"
                    style="@style/ApexPlayButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableStart="@drawable/ic_apex_play_dark"
                    android:drawablePadding="@dimen/_6sdp"
                    android:text="@string/dashboard_play" />
            </LinearLayout>

            <!-- Tasks -->
            <LinearLayout
                android:id="@+id/card_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:background="@drawable/bg_card_glass_flat"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <TextView
                    style="@style/ApexSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_tasks" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_tasks_hint"
                        android:textColor="@color/apex_text_secondary"
                        android:textSize="@dimen/_9ssp" />

                    <Button
                        android:id="@+id/share_logs_button"
                        style="@style/ApexChipButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_28sdp"
                        android:text="@string/main_share_logs" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Add account : glass panel over the dashboard wallpaper -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:id="@+id/login_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glass_strong"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/_520sdp"
        app:layout_constraintWidth_percent="0.86">

        <TextView
            style="@style/ApexSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="@string/auth_subtitle"
            android:textColor="@color/apex_text_secondary"
            android:textSize="@dimen/_10ssp" />

        <!-- Microsoft -->
        <LinearLayout
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_76sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_card_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_12sdp">

            <ImageView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_icon_tile_accent"
                android:contentDescription="@string/auth_microsoft_title"
                android:padding="@dimen/_11sdp"
                android:src="@drawable/ic_apex_microsoft"
                android:tint="@color/apex_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ApexCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_microsoft_title" />

                <TextView
                    style="@style/ApexCardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/auth_microsoft_sub" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_apex_chevron"
                android:tint="@color/apex_text_tertiary" />
        </LinearLayout>

        <!-- Local -->
        <LinearLayout
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_76sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_card_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_12sdp">

            <ImageView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_icon_tile_mint"
                android:contentDescription="@string/auth_local_title"
                android:padding="@dimen/_11sdp"
                android:src="@drawable/ic_apex_person"
                android:tint="@color/apex_mint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ApexCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_local_title" />

                <TextView
                    style="@style/ApexCardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/auth_local_sub" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_apex_chevron"
                android:tint="@color/apex_text_tertiary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="@string/auth_footnote"
            android:textColor="@color/apex_text_tertiary"
            android:textSize="@dimen/_9ssp"
            tools:ignore="LabelFor" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

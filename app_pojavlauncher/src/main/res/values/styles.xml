<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/apex_bg</item>
        <item name="android:statusBarColor">@color/apex_bg</item>
        <item name="android:navigationBarColor">@color/apex_bg</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <item name="android:textSize">@dimen/_12ssp</item>

    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- ============================================================
         Apex dashboard typography & components
         ============================================================ -->
    <style name="ApexSectionTitle">
        <item name="android:textColor">@color/apex_text_primary</item>
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ApexSectionLabel">
        <item name="android:textColor">@color/apex_text_tertiary</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ApexCardTitle">
        <item name="android:textColor">@color/apex_text_primary</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
    </style>

    <style name="ApexCardSubtitle">
        <item name="android:textColor">@color/apex_text_secondary</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ApexInstanceTitle">
        <item name="android:textColor">@color/apex_text_primary</item>
        <item name="android:textSize">@dimen/_22ssp</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ApexPlayButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_play_button</item>
        <item name="android:textColor">@color/apex_on_accent</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
        <item name="android:textSize">@dimen/_15ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableTint">@color/apex_on_accent</item>
    </style>

    <style name="ApexPlayButtonCompact" parent="ApexPlayButton">
        <item name="android:background">@drawable/bg_play_button_compact</item>
        <item name="android:textSize">@dimen/_13ssp</item>
    </style>

    <style name="ApexRailButton">
        <item name="android:layout_width">@dimen/_44sdp</item>
        <item name="android:layout_height">@dimen/_44sdp</item>
        <item name="android:padding">@dimen/_11sdp</item>
        <item name="android:background">@drawable/bg_rail_item</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/apex_text_secondary</item>
    </style>

    <style name="ApexRailButtonActive" parent="ApexRailButton">
        <item name="android:background">@drawable/bg_rail_item_active</item>
        <item name="android:tint">@color/apex_on_accent</item>
    </style>

    <style name="ApexChipButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_chip_dark</item>
        <item name="android:textColor">@color/apex_text_primary</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/_10sdp</item>
        <item name="android:paddingEnd">@dimen/_10sdp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
